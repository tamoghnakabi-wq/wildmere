---
import Base from '../layouts/Base.astro';
import { emblemInner } from '../lib/brand';
---

<Base title="Lost in the wild · Wildmere">
  <main id="main" class="lost">
    <svg viewBox="0 0 64 64" aria-hidden="true" set:html={emblemInner('nf', { bg: null })} />
    <h1>Lost in the wild</h1>
    <p>This page wandered off. The trail back starts here.</p>
    <a class="btn btn-primary" href="/">Back to Wildmere</a>
  </main>
</Base>

<style>
  .lost {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    padding: 24px;
    text-align: center;
    background: radial-gradient(50% 40% at 50% 40%, rgba(99, 224, 208, 0.08), transparent 70%);
  }
  svg {
    width: 72px;
    height: 72px;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
  }
  p {
    color: var(--muted);
  }
</style>
