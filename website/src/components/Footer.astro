---
import Icon from './Icon.astro';
import { emblemInner, wordmarkInner, WORDMARK_WIDTH, WORDMARK_HEIGHT } from '../lib/brand';
import { site, release, releasesUrl } from '../lib/data';

interface Props {
  usesIllustrations: boolean;
}
const { usesIllustrations } = Astro.props;
const year = new Date().getFullYear();
const credits = [
  ...site.credits,
  ...(usesIllustrations
    ? ['Illustrations on this site are placeholders drawn in code for the website; they are not in-game screenshots.']
    : []),
];
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <svg class="mark" viewBox="0 0 64 64" aria-hidden="true" set:html={emblemInner('ft-em', { bg: null, weight: 3 })} />
        <svg
          class="word"
          viewBox={`0 0 ${WORDMARK_WIDTH} ${WORDMARK_HEIGHT}`}
          role="img"
          aria-label={site.name}
          set:html={wordmarkInner('ft-wm', 'currentColor')}
        />
        <p class="tag">{site.tagline}</p>
      </div>
      <nav class="cols" aria-label="Footer">
        <div>
          <h2>Game</h2>
          <ul>
            <li><a href="#game">Overview</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#requirements">Requirements</a></li>
          </ul>
        </div>
        <div>
          <h2>Get it</h2>
          <ul>
            <li><a href="#download">Download v{release.version}</a></li>
            <li><a href="#install">Install guide</a></li>
            <li><a href={releasesUrl} rel="noopener">Release history</a></li>
          </ul>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li><a href={release.repo} rel="noopener"><Icon name="repo" /> GitHub repository</a></li>
            <li><a href={`${release.repo}/issues`} rel="noopener">Report a bug</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="credits">
      <h2 class="visually-hidden">Credits and licences</h2>
      <ul>
        {credits.map((c) => <li>{c}</li>)}
      </ul>
      <p class="legal">
        © {year} the Wildmere project. Source code, licence and full credits are in the <a href={release.repo} rel="noopener"
          >GitHub repository</a
        >.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: clamp(64px, 9vw, 120px) 0 48px;
    background:
      radial-gradient(60% 80% at 50% 0%, rgba(99, 224, 208, 0.05), transparent 70%),
      #030506;
    border-top: 1px solid var(--line);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
  }
  .brand {
    color: var(--bone);
  }
  .mark {
    width: 52px;
    height: 52px;
  }
  .word {
    width: min(320px, 100%);
    height: auto;
    margin-top: 22px;
  }
  .tag {
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--amber-2);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .cols h2 {
    font-family: var(--font-body);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    font-weight: 600;
  }
  .cols ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .cols a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .cols a:hover {
    color: var(--text);
  }
  .cols :global(svg) {
    width: 16px;
    height: 16px;
  }
  .credits {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-size: 0.84rem;
  }
  .credits ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
  }
  .legal {
    margin-top: 18px;
  }
  .legal a {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
