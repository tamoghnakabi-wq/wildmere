---
// Small original line icons (24px grid, 1.6 stroke). Decorative unless `label` is given.
interface Props {
  name: string;
  label?: string;
  class?: string;
}
const { name, label, class: cls } = Astro.props;
const P: Record<string, string> = {
  seed: '<path d="M12 21c0-6 0-9 0-11"/><path d="M12 10c-4.5 0-7-2.5-7-7 4.5 0 7 2.5 7 7Z"/><path d="M12 13c0-3.5 2.2-6 6.5-6 0 4-2.4 6-6.5 6Z"/><path d="M6 21h12"/>',
