  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.0",
    "marked": "^18.1.1",
    "sharp": "^0.35.5"
  }
}
