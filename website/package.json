{
  "name": "wildmere-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static landing page for Wildmere, an original voxel survival game.",
  "scripts": {
    "check:data": "node scripts/check-data.mjs",
    "prebuild": "node scripts/check-data.mjs",
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "build:demo": "WILDMERE_DEMO=1 node scripts/check-data.mjs && WILDMERE_DEMO=1 astro build --outDir dist-demo",
